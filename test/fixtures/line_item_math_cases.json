      "expect": { "itemsCents": 85000, "discountCents": 0, "taxableCents": 55000, "taxCents": 5775, "totalCents": 90775, "costCents": 52944, "profitCents": 32056, "marginPct": 37.7, "unpricedLines": 0, "missingCostLines": 0, "zeroUnconfirmedLines": 0 }
