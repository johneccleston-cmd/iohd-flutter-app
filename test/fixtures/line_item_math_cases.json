      "expect": { "itemsCents": 100000, "discountCents": 10000, "taxableCents": 90000, "taxCents": 9000, "totalCents": 99000, "costCents": 70000, "profitCents": 20000, "marginPct": 22.2, "unpricedLines": 1, "missingCostLines": 0, "zeroUnconfirmedLines": 0 }
    },
    {
      "name": "no tax rate, and a discount bigger than the taxable items never makes tax negative",
      "taxRate": null,
      "items": [
        { "kind": "item", "quantity": 1, "rate": 50, "cost": 20, "taxable": true },
        { "kind": "discount", "rate": 80, "taxable": true }
