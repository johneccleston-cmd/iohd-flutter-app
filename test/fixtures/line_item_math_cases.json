      "expect": { "itemsCents": 4102767, "discountCents": 748000, "taxableCents": 1902767, "taxCents": 185520, "totalCents": 3540287, "costCents": 0, "profitCents": null, "marginPct": null, "unpricedLines": 0, "missingCostLines": 2, "zeroUnconfirmedLines": 0 }
