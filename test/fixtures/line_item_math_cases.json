      "expect": { "itemsCents": 40000, "discountCents": 0, "taxableCents": 10000, "taxCents": 975, "totalCents": 40975, "costCents": 4000, "profitCents": null, "marginPct": null, "unpricedLines": 0, "missingCostLines": 1, "zeroUnconfirmedLines": 0 }
