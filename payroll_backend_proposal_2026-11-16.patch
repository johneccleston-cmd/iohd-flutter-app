+    CENT_ROUNDING_FROM_WEEK: '2026-11-09',
     RETAINAGE_RATE: 0.20,
     CALLBACK_PAYOUT: 50,
     // High-volume builders: callbacks on their jobs earn no callback pay. Matched on the job's
@@ -694,6 +699,13 @@ job_settlement AS (
         x.advances - LEAST(x.advances, GREATEST(0, x.share - x.retained)) AS advance_shortfall,
         GREATEST(0, x.share - x.retained - x.advances) AS job_net
     FROM (
+        -- Money is rounded to the cent here, once per person per job (CENT_ROUNDING_FROM_WEEK on), so the repaid, shortfall
