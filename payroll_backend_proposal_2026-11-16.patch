+               CASE WHEN v.week_start >= DATE '${R.CENT_ROUNDING_FROM_WEEK}' THEN ROUND(v.share, 2) ELSE v.share END AS share,
+               CASE WHEN v.week_start >= DATE '${R.CENT_ROUNDING_FROM_WEEK}' THEN ROUND(v.retained, 2) ELSE v.retained END AS retained
+        FROM (
         SELECT
             y.*,
             -- A closed job whose pay week already has a finalized run that did not pay this tech for this job falls on the
@@ -733,6 +745,7 @@ job_settlement AS (
             WHERE a.job_complete AND a.is_verified IS TRUE
             GROUP BY a.user_id, a.job_id
         ) y
+        ) v
     ) x
