+// Audit 2026-11-19 (Services Catalog redesign).
+test('a rename to a name another service has is refused (409), whatever its case and spacing; its own name is fine', async () => {
+    const lines = [...LEGACY_LINES, { name: 'Commercial Service | Call', is_service: true, rate: '99', ext_cost: '20', qty: '1', description: '', taxed: false, at: '2026-10-03' }];
