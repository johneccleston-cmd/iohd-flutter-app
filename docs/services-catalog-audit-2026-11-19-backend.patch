+    await withServer(app(pool), async (base) => {
+        const r = await call(base, 'PUT', '/api/catalog/services/override', { body: { key: KEY, name: '  commercial service|CALL ' } });
+        assert.equal(r.status, 409);
+        assert.equal(r.body.error, 'Another service is already called "Commercial Service | Call".');
+        assert.equal(pool.store.size, 0, 'nothing saved');
+        const own = await call(base, 'PUT', '/api/catalog/services/override', { body: { key: KEY, name: 'RESIDENTIAL SERVICE' } });
+        assert.equal(own.status, 200);
+    });
+});
