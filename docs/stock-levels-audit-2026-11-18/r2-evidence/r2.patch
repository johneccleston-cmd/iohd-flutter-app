+
+process.env.API_SECRET = process.env.API_SECRET || 'test-app-key';
+process.env.TOKEN_SECRET = process.env.TOKEN_SECRET || 'test-token-secret';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { createSheet, createMemoryStore, loadInventory, atTime, BEFORE_831, AFTER_831, PARTS } = require('./stock_fakes');
+const { hashPin, verifyPin } = require('../src/auth');
+
+const sheet = createSheet();
+const CHECKOUT = '/checkout_inventory';
+const SCAN = '/scan_checkout';
