+// R1b: the push to the person when a checkout line is probably a stocked part under another name (src/stockMismatch.js).
+// Unit tests on the rule (against the real 18 Nov Sheet snapshot and every production job line name), then the REAL
+// inventory router: mixed checkouts, doors and services, retries, two servers, staging, failures.
+// Runs on R1 + R1b alone and on R2 (tests that need R2's request ids or shared store skip themselves without them).
+
+process.env.API_SECRET = process.env.API_SECRET || 'test-app-key';
+process.env.TOKEN_SECRET = process.env.TOKEN_SECRET || 'test-token-secret';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const fx = require('./stock_fakes');
+const { createSheet, loadInventory, atTime, BEFORE_831, AFTER_831, PARTS } = fx;
+const { words, likelySheetRow, likelyMismatches, noticeText, fingerprint, createMismatchNotifier } = require('../src/stockMismatch');
+
+const SNAPSHOT = require('./fixtures/stock_sheet_rows_2026-11-18.json');
+const ROWS = [['Part Number', 'Part Name', 'Location', 'Qty'], ...SNAPSHOT.map((r) => [r.partNumber, r.name, r.location, String(r.qty)])];
+const CORPUS = require('./fixtures/stock_job_line_names_2026-11-19.json').rows;
+const FLAGGED = require('./fixtures/stock_mismatch_flagged_2026-11-19.json').flagged;
+const quiet = { log() {}, warn() {}, error() {} };
+const settle = () => new Promise((r) => setTimeout(r, 30)); // the push is sent after the answer, not awaited
+const R2 = typeof fx.createMemoryStore === 'function';
+
+// ─── the rule ────────────────────────────────────────────────────────────────────────────────────────────────────────
+
+test('the seven audit near-misses each point at exactly the Sheet row with the same part number', () => {
+    const expected = [
+        ["Stop Mold | 7' White", "Weather Seal | Stop Mold | 7' White", '0650732', 'BD'],
+        ["Stop Mold | 16' White", "Weather Seal | Stop Mold | 16' White", '0650738', 'BE'],
+        ["Stop Mold | 7' Black", "Weather Seal | Stop Mold | 7' Black", '0650832', 'BD'],
+        ['Keypads | 877LM | LiftMaster', 'Keypad | 877LM | LiftMaster', '4128529', ''],
+        ['Punched Angle | 1-1/4" x 1-1/4" | 8\'', 'Punched Angle | 16GA | 1-1/4" x 1-1/4" x 8\' | Galvanized', '0170015', 'BK1'],
+        ['Punched Angle | 2" x 2" | 10\' | Taxable', 'Punched Angle | 12GA | 2" × 2" × 10\' | Galvanized', '0170030', 'BK1'],
+        ['Operator Parts | PUSHER SPRING KIT QUIET | 27" LONG LH & RH', 'Operator Parts | PUSHER SPRING KIT | 27" LONG LH & RH', '4152730', 'AL'],
+    ];
+    for (const [line, name, partNumber, location] of expected) {
+        const m = likelySheetRow(line, ROWS);
+        assert.ok(m, `${line} should be flagged`);
+        assert.deepStrictEqual([m.name, m.partNumber, m.location], [name, partNumber, location], line);
+    }
+});
+
+test('doors, services, labour and other non-stock lines are never flagged (synthetic examples)', () => {
+    const nonStock = [
+        'Clopay Gallery Steel | GD5S | Complete Door', 'Service | Tune-Up', 'Labor | Install', 'Trip Charge', 'Diagnostic Fee',
+        'Weather Seal | Stop Mold | Install New Standard Color', 'Weather Seal | Stop Mold | Install New Premium Color',
+        'Haul Away Old Door', 'Clopay Section Replacement | 9208 | 24in', 'Warranty Repair', 'Discount', 'Keypad', 'Stop Mold',
+    ];
+    for (const n of nonStock) assert.strictEqual(likelySheetRow(n, ROWS), null, n);
+});
+
+test('every production job line name: nothing that reads as a door, service, labour or fee is flagged', () => {
+    const service = /\b(services?|labou?r|install(ation)?|trip|charge|diagnostic|warranty|removal|haul|permit|discount|fee|complete door|section replacement|tune[- ]?up|maintenance|inspection|estimate)\b/i;
+    const exact = new Set(SNAPSHOT.map((r) => r.name.toLowerCase().trim()));
+    let checked = 0;
+    for (const c of CORPUS) {
+        if (exact.has(c.name.toLowerCase().trim())) continue;
+        checked++;
+        if (likelySheetRow(c.name, ROWS) && service.test(c.name)) assert.fail(`flagged a non-stock line: ${c.name}`);
+    }
+    assert.strictEqual(checked, 3425);
+});
+
+test('every production job line name: the flagged set is exactly the reviewed list (170 names)', () => {
+    const exact = new Set(SNAPSHOT.map((r) => r.name.toLowerCase().trim()));
+    const now = CORPUS.filter((c) => !exact.has(c.name.toLowerCase().trim())).map((c) => [c.name, likelySheetRow(c.name, ROWS)?.name]).filter(([, m]) => m);
+    assert.deepStrictEqual(new Map(now), new Map(FLAGGED.map((f) => [f.lineName, f.sheetName])));
+    assert.strictEqual(now.length, 170);
+});
+
+test('an exact Sheet name, an ambiguous name and a too-short name are never flagged', () => {
+    assert.strictEqual(likelySheetRow("Weather Seal | Stop Mold | 7' White", ROWS), null);
+    const twoRows = [ROWS[0], ['1', 'Remote | 893LM | LiftMaster | Black', 'R1', '1'], ['2', 'Remote | 893LM | LiftMaster | Gray', 'R2', '1']];
+    assert.strictEqual(likelySheetRow('Remotes | 893LM | LiftMaster', twoRows), null); // two candidates: say nothing
+    assert.strictEqual(likelySheetRow('Keypads | Genie', ROWS), null); // two words
+});
+
+test('words: case, pipes, ×, plurals and "Taxable" do not matter; sizes are kept as they are', () => {
+    assert.deepStrictEqual([...words('Punched Angle | 2" × 2" × 10\' | Taxable')], ['punched', 'angle', '2"', 'x', '10\'']);
+    assert.deepStrictEqual([...words('Keypads | 877LM | LiftMaster')], ['keypad', '877lm', 'liftmaster']);
+    assert.ok(words("Stop Mold | 16' White").has("16'"));
+});
+
+test('the message names the line, the job, the Sheet name, the part number and shelf, and what to do', () => {
+    const ms = likelyMismatches([{ name: "Stop Mold | 7' White", jobNumber: '4001', qtyUsed: 2 }], [{ outcome: 'not_stocked' }], ROWS);
+    const { title, body } = noticeText(ms);
+    assert.strictEqual(title, '⚠️ Not taken off stock');
+    assert.strictEqual(body, '1 part was not taken off stock: "Stop Mold | 7\' White" (job 4001) looks like "Weather Seal | Stop Mold | 7\' White" on the stock sheet (part 0650732, shelf BD). Tell the office so the names can be matched; the rest of your checkout went through.');
+    const five = ['Stop Mold | 7\' White', 'Stop Mold | 16\' White', 'Stop Mold | 7\' Black', 'Keypads | 877LM | LiftMaster', 'Stop Mold | 9\' White']
+        .map((name, i) => ({ name, jobNumber: String(i), qtyUsed: 1 }));
+    const many = noticeText(likelyMismatches(five, five.map(() => ({ outcome: 'not_stocked' })), ROWS));
+    assert.match(many.body, /^5 parts were not taken off stock: .*\. And 2 more\. Tell the office/);
+    assert.ok(many.body.length < 1000);
+});
+
+test('a checkout retry has the same fingerprint whatever the line order; another person or day does not', () => {
+    const ms = likelyMismatches([{ name: "Stop Mold | 7' White", jobNumber: '1', qtyUsed: 2 }, { name: 'Keypads | 877LM | LiftMaster', jobNumber: '2', qtyUsed: 1 }],
+        [{ outcome: 'not_stocked' }, { outcome: 'not_stocked' }], ROWS);
+    const a = fingerprint({ person: 'Brett Miller', businessDate: '2026-11-19', mismatches: ms });
+    assert.strictEqual(fingerprint({ person: 'brett miller ', businessDate: '2026-11-19', mismatches: [...ms].reverse() }), a);
+    assert.notStrictEqual(fingerprint({ person: 'Andrew Johnson', businessDate: '2026-11-19', mismatches: ms }), a);
+    assert.notStrictEqual(fingerprint({ person: 'Brett Miller', businessDate: '2026-11-20', mismatches: ms }), a);
+});
+
+test('the notifier never throws: a token lookup or send failure is logged and reported', async () => {
+    const notify = createMismatchNotifier({ getToken: async () => { throw new Error('db down'); }, send: async () => {}, log: quiet });
+    const r = await notify({ person: 'P', businessDate: 'd', lines: [{ name: "Stop Mold | 7' White", qtyUsed: 1 }], outcomes: [{ outcome: 'not_stocked' }], rows: ROWS });
+    assert.deepStrictEqual(r, { sent: false, reason: 'error' });
+});
+
+// ─── the real router ─────────────────────────────────────────────────────────────────────────────────────────────────
+
+const CHECKOUT = '/checkout_inventory';
+const SEAL = PARTS.SEAL;
+const DOOR = 'Clopay Gallery Steel | GD5S | Complete Door';
+const TUNEUP = 'Service | Tune-Up';
+const line = (name, qtyUsed, jobNumber) => ({ name, qtyUsed, jobNumber });
+const tokens = { 'Brett Miller': 'tok-brett', Warehouse: 'tok-warehouse', 'Andrew Johnson': 'tok-andrew' };
+const asUser = (req, res, next) => { const u = req.headers['x-test-user']; if (u) req.user = JSON.parse(u); next(); };
+const BRETT = JSON.stringify({ id: 12, name: 'Brett Miller', username: 'bmiller', role: 'Technician' });
+
+function withConsole(fn) {
+    const lines = [];
+    const orig = { log: console.log, warn: console.warn, error: console.error };
+    for (const k of Object.keys(orig)) console[k] = (...a) => lines.push(a.map(String).join(' '));
+    return Promise.resolve().then(fn).finally(() => Object.assign(console, orig)).then((v) => ({ v, lines }));
+}
+
+test('mixed checkout: one push naming only the likely mismatch; doors and services are left out; stock as before', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.KEYPAD]);
+    const inv = loadInventory({ sheet, tokens, requireAuth: asUser });
+    const { v: r, lines } = await withConsole(async () => {
+        const out = await inv.call('POST', CHECKOUT, { headers: { 'x-test-user': BRETT }, body: { techName: 'Brett Miller', items: [
+            line("Stop Mold | 7' White", 2, '4001'), line(PARTS.KEYPAD[1], 1, '4001'), line(PARTS.KEYPAD[1], 1, '4002'),
+            line(DOOR, 1, '4002'), line(TUNEUP, 1, '4003')] } });
+        await settle();
+        return out;
+    });
+    assert.strictEqual(r.status, 200);
+    assert.strictEqual(r.body.status, 'partial');
+    assert.strictEqual(sheet.qty(PARTS.KEYPAD[1]), '8.00');
+    assert.strictEqual(sheet.qty(SEAL[1]), '60.00');
+    assert.strictEqual(inv.pushes.length, 1);
+    const [p] = inv.pushes;
+    assert.strictEqual(p.token, 'tok-brett');
+    assert.strictEqual(p.notification.title, '⚠️ Not taken off stock');
+    assert.match(p.notification.body, /"Stop Mold \| 7' White" \(job 4001\) looks like "Weather Seal \| Stop Mold \| 7' White" on the stock sheet \(part 0650747, shelf S1\)/);
+    assert.ok(!/Clopay|Tune-Up|Keypad/.test(p.notification.body));
+    assert.ok(lines.some((l) => /🧩 Likely name mismatch, not taken off stock: "Stop Mold \| 7' White" \(job 4001, qty 2\)/.test(l)), 'the office can see it in the log');
+});
+
+test('a checkout whose only unmatched lines are doors and services sends no push', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const inv = loadInventory({ sheet, tokens });
+    await withConsole(async () => {
+        await inv.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line(SEAL[1], 1, '1'), line(DOOR, 1, '1'), line(TUNEUP, 1, '2')] } });
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 0);
+});
+
+test('a checkout where everything came off stock sends no push', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.KEYPAD]);
+    const inv = loadInventory({ sheet, tokens });
+    await inv.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line(SEAL[1], 1, '1'), line(PARTS.KEYPAD[1], 1, '1')] } });
+    await settle();
+    assert.strictEqual(inv.pushes.length, 0);
+});
+
+test('the same checkout sent again (an old build retrying, no request id) is not notified twice', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const inv = loadInventory({ sheet, tokens });
+    const body = { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '4001'), line(SEAL[1], 1, '4001')] };
+    await withConsole(async () => {
+        await inv.call('POST', CHECKOUT, { body });
+        await settle();
+        await inv.call('POST', CHECKOUT, { body });
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 1);
+});
+
+test('the same checkout replayed by its Idempotency-Key is not notified twice (R2)', { skip: R2 ? false : 'R2 request ids' }, async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const inv = loadInventory({ sheet, tokens });
+    const headers = { 'idempotency-key': '6f1c1d2e-9a41-4d7e-8f2a-000000000077' };
+    const body = { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '4001')] };
+    await withConsole(async () => {
+        await inv.call('POST', CHECKOUT, { headers, body });
+        await settle();
+        const again = await inv.call('POST', CHECKOUT, { headers, body });
+        assert.strictEqual(again.body.replayed, true);
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 1);
+});
+
+test('the same checkout landing on two servers is notified once (R2: the claim is shared through Postgres)', { skip: R2 ? false : 'R2 shared store' }, async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const db = fx.createMemoryStore();
+    const a = loadInventory({ sheet, tokens, store: db });
+    const b = loadInventory({ sheet, tokens, store: db });
+    const body = { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '4001')] };
+    await withConsole(async () => {
+        await a.call('POST', CHECKOUT, { body });
+        await b.call('POST', CHECKOUT, { body });
+        await settle();
+    });
+    assert.strictEqual(a.pushes.length + b.pushes.length, 1);
+});
+
+test('a different person, or a different unmatched line, is a new checkout and is notified', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const inv = loadInventory({ sheet, tokens });
+    await withConsole(async () => {
+        await inv.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '4001')] } });
+        await inv.call('POST', CHECKOUT, { body: { techName: 'Andrew Johnson', items: [line("Stop Mold | 7' White", 2, '4001')] } });
+        await inv.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 3, '4009')] } });
+        await settle();
+    });
+    assert.deepStrictEqual(inv.pushes.map((p) => p.token), ['tok-brett', 'tok-andrew', 'tok-brett']);
+});
+
+test('no phone registered, or the push service down: the checkout answer is unchanged and the miss is still logged', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL]);
+    const noToken = loadInventory({ sheet, tokens: {} });
+    const { v: a, lines } = await withConsole(async () => {
+        const out = await noToken.call('POST', CHECKOUT, { body: { techName: 'Nobody', items: [line("Stop Mold | 7' White", 2, '1')] } });
+        await settle();
+        return out;
+    });
+    assert.strictEqual(a.status, 200);
+    assert.ok(lines.some((l) => /📵 No phone registered for Nobody/.test(l)));
+    const down = loadInventory({ sheet, tokens, failPush: true });
+    const { v: b, lines: l2 } = await withConsole(async () => {
+        const out = await down.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '2')] } });
+        await settle();
+        return out;
+    });
+    assert.strictEqual(b.status, 200);
+    assert.ok(l2.some((l) => /Mismatch notice failed \(the checkout itself is unaffected\): fcm down/.test(l)));
+});
+
+test('warehouse staging before 8:31: the mismatch is pushed when it is staged, and not again at the 8:31 flush', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.ANGLE]);
+    const inv = loadInventory({ sheet, tokens, requireAuth: asUser });
+    const station = JSON.stringify({ id: 40, name: 'Warehouse', username: 'warehouse1', role: 'Warehouse' });
+    await withConsole(async () => {
+        // The push goes to the signed-in login's phone (the warehouse phone), not to the typed name.
+        const r = await atTime(BEFORE_831, () => inv.call('POST', CHECKOUT, { headers: { 'x-test-user': station }, body: { techName: 'warehouse1', items: [line("Stop Mold | 7' White", 2, '7001'), line(PARTS.ANGLE[1], 2, '7001')] } }));
+        assert.match(r.body.message, /^Items staged/);
+        await settle();
+        assert.strictEqual(inv.pushes.length, 1);
+        assert.strictEqual(inv.pushes[0].token, 'tok-warehouse');
+        await atTime(AFTER_831, () => inv.cron('31 8 * * *')());
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 1);
+    assert.strictEqual(sheet.qty(PARTS.ANGLE[1]), '38.00');
+});
