+    assert.strictEqual(a.status, 200);
+    assert.ok(lines.some((l) => /📵 No phone registered for Nobody/.test(l)));
+    const down = loadInventory({ sheet, tokens, failPush: true });
+    const { v: b, lines: l2 } = await withConsole(async () => {
+        const out = await down.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '2')] } });
+        await settle();
+        return out;
+    });
+    assert.strictEqual(b.status, 200);
+    assert.ok(l2.some((l) => /Mismatch notice failed \(the checkout itself is unaffected\): fcm down/.test(l)));
+});
