+test('warehouse staging before 8:31: the mismatch is pushed when it is staged, and not again at the 8:31 flush', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.ANGLE]);
+    const inv = loadInventory({ sheet, tokens, requireAuth: asUser });
+    const station = JSON.stringify({ id: 40, name: 'Warehouse', username: 'warehouse1', role: 'Warehouse' });
+    await withConsole(async () => {
+        // The push goes to the signed-in login's phone (the warehouse phone), not to the typed name.
+        const r = await atTime(BEFORE_831, () => inv.call('POST', CHECKOUT, { headers: { 'x-test-user': station }, body: { techName: 'warehouse1', items: [line("Stop Mold | 7' White", 2, '7001'), line(PARTS.ANGLE[1], 2, '7001')] } }));
+        assert.match(r.body.message, /^Items staged/);
+        await settle();
+        assert.strictEqual(inv.pushes.length, 1);
+        assert.strictEqual(inv.pushes[0].token, 'tok-warehouse');
+        await atTime(AFTER_831, () => inv.cron('31 8 * * *')());
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 1);
+    assert.strictEqual(sheet.qty(PARTS.ANGLE[1]), '38.00');
+});
