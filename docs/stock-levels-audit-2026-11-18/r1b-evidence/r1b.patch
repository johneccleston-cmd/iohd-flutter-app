diff -ruN '--exclude=node_modules' r1base/src/stockMismatch.js r1b/src/stockMismatch.js
--- r1base/src/stockMismatch.js	1969-12-31 18:00:00.000000000 -0600
+++ r1b/src/stockMismatch.js	2026-11-19 08:18:47.596780700 -0600
@@ -0,0 +1,152 @@
+// stockMismatch.js: tell the person when a checkout line is probably a stocked part under another name.
+// Stock Levels Phase 1, R1b (approved for local implementation 2026-11-19; not released).
+//
+// Why: a Service Fusion line such as "Stop Mold | 7' White" has no row on the Inventory sheet, whose row is
+// "Weather Seal | Stop Mold | 7' White". The checkout logs it but takes nothing off stock (audit C1). The answer says
+// "partial", but phone builds 33-36 ignore it and show "Checked out" / "Your list is done". Both builds DO show push
+// notifications with a title and body (MyFcmService), the channel the 4 PM "Inventory Overdue" alert uses, so the
+// person is told that way.
+//
+// Who is NOT told: doors, services, labour and every other line the warehouse doesn't stock. Most unmatched lines are
+// those (the audit's 142 of 470), so a push for each would be noise. A line counts as a likely stocked part only when
+// its words and exactly ONE Sheet row's words are the same apart from naming noise:
+//   - every word of the line is in that row's name (the row has extra words, e.g. "Weather Seal | Stop Mold | 7' White"),
+//     with at least MIN_WORDS words, or
+//   - every word of that row is in the line, with at most MAX_EXTRA extra words on the line ("... KIT QUIET | 27" ..."),
+//     and the row has at least MIN_WORDS words.
+// Words: lower case; split on | , ( ) and spaces; "×" read as "x"; "keypads" as "keypad"; "taxable" and "&" ignored.
+// Checked against every distinct job line name in production (test/stock_mismatch.test.js and the evidence file).
+//
+// One push per checkout: retries of the same checkout (same person, same day, same unmatched lines) are not told again,
+// for 12 hours. The claim is in this server's memory by default; R2 passes a Postgres-backed claim so it also holds
+// across servers.
+'use strict';
+
+const crypto = require('node:crypto');
+
+const MIN_WORDS = 3;
+const MAX_EXTRA = 2;
+const MAX_LISTED = 3;
+const DEDUPE_MS = 12 * 60 * 60 * 1000;
+const NOISE = new Set(['taxable', '&', 'and', '-', '–', '+']);
+
+const nameKey = (v) => String(v ?? '').toLowerCase().trim();
+
+/** The words of a part name, as a Set. */
+function words(name) {
+    const out = new Set();
+    for (let w of String(name ?? '').toLowerCase().replace(/×/g, ' x ').split(/[|,()\s]+/)) {
+        w = w.replace(/^[.;:]+|[.;:]+$/g, '');
+        if (!w || NOISE.has(w)) continue;
+        // Plural to singular for plain words only (keypads -> keypad, springs -> spring); never for sizes like 16'.
+        if (/^[a-z]{4,}s$/.test(w) && !/ss$/.test(w)) w = w.slice(0, -1);
+        out.add(w);
+    }
+    return out;
+}
+const subset = (a, b) => { for (const x of a) if (!b.has(x)) return false; return true; };
+
+/**
+ * The Sheet row a checkout line most likely means, or null.
+ * rows: Inventory!A:F as read (A part number, B name, C location, D quantity); row 0 is the header.
+ */
+function likelySheetRow(lineName, rows) {
+    const lw = words(lineName);
+    if (!lw.size) return null;
+    const hits = [];
+    for (let i = 1; i < (rows || []).length; i++) {
+        const name = rows[i]?.[1];
+        if (!name) continue;
+        if (nameKey(name) === nameKey(lineName)) return null; // an exact row exists: not a mismatch at all
+        const rw = words(name);
+        const lineInRow = lw.size >= MIN_WORDS && subset(lw, rw);
+        const rowInLine = rw.size >= MIN_WORDS && subset(rw, lw) && lw.size - rw.size <= MAX_EXTRA;
+        if (lineInRow || rowInLine) hits.push(i);
+    }
+    if (hits.length !== 1) return null; // none, or ambiguous: say nothing rather than guess
+    const r = rows[hits[0]];
+    return { row: hits[0] + 1, name: String(r[1]).trim(), partNumber: String(r[0] ?? '').trim(), location: String(r[2] ?? '').trim() };
+}
+
+/**
+ * The lines of one checkout that did not come off stock and probably should have.
+ * lines: [{ name, jobNumber, qtyUsed }]; outcomes: one per line ({ outcome }), as the checkout answer has them.
+ */
+function likelyMismatches(lines, outcomes, rows) {
+    const out = [];
+    lines.forEach((line, i) => {
+        if ((outcomes[i]?.outcome) !== 'not_stocked') return;
+        const match = likelySheetRow(line.name, rows);
+        if (match) out.push({ name: line.name, jobNumber: line.jobNumber ?? null, qtyUsed: line.qtyUsed, match });
+    });
+    return out;
+}
+
+/** The push: what didn't come off stock, what the Sheet calls it, where it is, and what to do. */
+function noticeText(mismatches) {
+    const describe = (m) => {
+        const where = [m.match.partNumber && `part ${m.match.partNumber}`, m.match.location && `shelf ${m.match.location}`].filter(Boolean).join(', ');
+        return `"${m.name}"${m.jobNumber ? ` (job ${m.jobNumber})` : ''} looks like "${m.match.name}" on the stock sheet${where ? ` (${where})` : ''}`;
+    };
+    const listed = mismatches.slice(0, MAX_LISTED).map(describe);
+    const more = mismatches.length > MAX_LISTED ? ` And ${mismatches.length - MAX_LISTED} more.` : '';
+    const lead = mismatches.length === 1 ? '1 part was not taken off stock: ' : `${mismatches.length} parts were not taken off stock: `;
+    return {
+        title: '⚠️ Not taken off stock',
+        body: `${lead}${listed.join('; ')}.${more} Tell the office so the names can be matched; the rest of your checkout went through.`,
+    };
+}
+
+/** Same person, same day, same unmatched lines = the same checkout sent again. */
+function fingerprint({ person, businessDate, mismatches }) {
+    const lines = mismatches.map((m) => `${m.jobNumber ?? ''}|${nameKey(m.name)}|${m.qtyUsed}`).sort();
+    return crypto.createHash('sha256').update(`${nameKey(person)}\n${businessDate}\n${lines.join('\n')}`).digest('hex').slice(0, 32);
+}
+
+function memoryClaim(ttlMs = DEDUPE_MS, now = () => Date.now()) {
+    const seen = new Map();
+    return async (key) => {
+        const t = now();
+        for (const [k, at] of seen) if (t - at > ttlMs) seen.delete(k);
+        if (seen.has(key)) return false;
+        seen.set(key, t);
+        return true;
+    };
+}
+
+/**
+ * notify({ person, businessDate, lines, outcomes, rows, requestId }) finds the likely mismatches and, at most once per
+ * checkout, pushes them to the person's phone. It never throws and never delays the checkout (callers don't await it
+ * before answering). Returns what it did, for tests and logs.
+ *   getToken(person) -> FCM token or null (services.getTechToken)
+ *   send(message)    -> admin.messaging().send
+ *   claim(key)       -> true the first time a key is seen (memory by default; Postgres in R2)
+ */
+function createMismatchNotifier({ getToken, send, claim = memoryClaim(), log = console } = {}) {
+    return async function notify({ person, businessDate, lines, outcomes, rows, requestId }) {
+        try {
+            const mismatches = likelyMismatches(lines || [], outcomes || [], rows || []);
+            if (!mismatches.length) return { sent: false, reason: 'none' };
+            for (const m of mismatches) {
+                log.warn(`🧩 Likely name mismatch, not taken off stock: "${m.name}" (job ${m.jobNumber ?? '?'}, qty ${m.qtyUsed}) is probably "${m.match.name}" (Inventory row ${m.match.row}, part ${m.match.partNumber || '-'}), checked out by ${person || 'unknown'}${requestId ? `, request ${requestId}` : ''}.`);
+            }
+            const key = fingerprint({ person, businessDate, mismatches });
+            let first = true;
+            try { first = await claim(key, businessDate); } catch (e) { log.error('⚠️ Mismatch notice dedupe check failed; sending anyway:', e.message); }
+            if (!first) return { sent: false, reason: 'duplicate', mismatches };
+            const token = person ? await getToken(person) : null;
+            if (!token) {
+                log.warn(`📵 No phone registered for ${person || 'unknown'}: the mismatch notice was not pushed (logged above).`);
+                return { sent: false, reason: 'no_token', mismatches };
+            }
+            const notification = noticeText(mismatches);
+            await send({ notification, token });
+            return { sent: true, notification, mismatches };
+        } catch (err) {
+            log.error('❌ Mismatch notice failed (the checkout itself is unaffected):', err.message);
+            return { sent: false, reason: 'error' };
+        }
+    };
+}
+
+module.exports = { words, likelySheetRow, likelyMismatches, noticeText, fingerprint, memoryClaim, createMismatchNotifier, MIN_WORDS, MAX_EXTRA, DEDUPE_MS };
