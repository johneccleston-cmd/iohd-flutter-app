+test('push off: warehouse staging before 8:31 logs the mismatch, sends nothing, and the 8:31 flush is unchanged', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.ANGLE]);
+    const t = countingTokens({ ...tokens });
+    const inv = withPushEnv(undefined, () => loadInventory({ sheet, tokens: t.tokens, requireAuth: asUser }));
+    const station = JSON.stringify({ id: 40, name: 'Warehouse', username: 'warehouse1', role: 'Warehouse' });
+    const { lines } = await withConsole(async () => {
+        const r = await atTime(BEFORE_831, () => inv.call('POST', CHECKOUT, { headers: { 'x-test-user': station }, body: { techName: 'warehouse1', items: [line("Stop Mold | 7' White", 2, '7001'), line(PARTS.ANGLE[1], 2, '7001')] } }));
+        assert.match(r.body.message, /^Items staged/);
+        await settle();
+        await atTime(AFTER_831, () => inv.cron('31 8 * * *')());
+        await settle();
+    });
+    assert.strictEqual(inv.pushes.length, 0);
+    assert.deepStrictEqual(t.seen, []);
+    assert.strictEqual(lines.filter((l) => l.includes('🧩 Likely name mismatch')).length, 1);
+    assert.strictEqual(sheet.qty(PARTS.ANGLE[1]), '38.00');
+    assert.strictEqual(sheet.qty(SEAL[1]), '60.00');
+});
