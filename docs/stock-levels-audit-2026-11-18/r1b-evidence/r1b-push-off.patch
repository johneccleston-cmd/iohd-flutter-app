+
+// ─── this release: push off (19 Nov 2026) ────────────────────────────────────────────────────────────────────────────
+// The installed phone builds never register for pushes, so R1b ships as mismatch detection + office log only.
+
+/** Tokens that count every lookup, so a test can prove the push path was never entered. */
+function countingTokens(map) {
+    const seen = [];
+    return { seen, tokens: new Proxy(map, { get: (t, k) => { if (typeof k === 'string') seen.push(k); return t[k]; } }) };
+}
+const MIXED = [line("Stop Mold | 7' White", 2, '4001'), line(PARTS.KEYPAD[1], 1, '4001'), line(PARTS.KEYPAD[1], 1, '4002'), line(DOOR, 1, '4002'), line(TUNEUP, 1, '4003')];
+
+test('push off by default: the mismatch is detected and logged for the office; no token lookup, nothing sent', async () => {
+    const sheet = createSheet();
+    sheet.reset([SEAL, PARTS.KEYPAD]);
+    const t = countingTokens({ ...tokens });
+    const inv = withPushEnv(undefined, () => loadInventory({ sheet, tokens: t.tokens, requireAuth: asUser, failPush: true }));
+    const { v: r, lines } = await withConsole(async () => {
+        const out = await inv.call('POST', CHECKOUT, { headers: { 'x-test-user': BRETT }, body: { techName: 'Brett Miller', items: MIXED } });
+        await settle();
+        return out;
+    });
+    assert.strictEqual(r.status, 200);
+    assert.strictEqual(r.body.status, 'partial');
+    assert.strictEqual(inv.pushes.length, 0, 'nothing sent');
+    assert.deepStrictEqual(t.seen, [], 'no FCM token looked up');
+    const mismatchLines = lines.filter((l) => l.includes('🧩 Likely name mismatch'));
+    assert.strictEqual(mismatchLines.length, 1, 'one office log line, for Stop Mold only');
+    assert.match(mismatchLines[0], /"Stop Mold \| 7' White" \(job 4001, qty 2\) is probably "Weather Seal \| Stop Mold \| 7' White" \(Inventory row 2, part 0650747\), checked out by Brett Miller/);
+    assert.ok(!lines.some((l) => /📵|Mismatch notice failed|dedupe/.test(l)), 'no push-path log lines');
+});
+
+test('push off: the checkout answer, stock writes and PickedItems log are identical to push on', async () => {
+    async function run(pushEnv) {
+        const sheet = createSheet();
+        sheet.reset([SEAL, PARTS.KEYPAD]);
+        const inv = withPushEnv(pushEnv, () => loadInventory({ sheet, tokens, requireAuth: asUser }));
+        const { v: r } = await withConsole(async () => {
+            const out = await inv.call('POST', CHECKOUT, { headers: { 'x-test-user': BRETT }, body: { techName: 'Brett Miller', items: MIXED } });
+            await settle();
+            return out;
+        });
+        return { body: r.body, writes: sheet.writes, picked: sheet.picked, inventory: sheet.inventory, pushes: inv.pushes.length };
+    }
+    const off = await run(undefined);
+    const on = await run('on');
+    assert.strictEqual(off.pushes, 0);
+    assert.strictEqual(on.pushes, 1);
+    assert.deepStrictEqual(off.body, on.body);
+    assert.deepStrictEqual(off.writes, on.writes);
+    assert.deepStrictEqual(off.picked, on.picked);
+    assert.deepStrictEqual(off.inventory, on.inventory);
+    // Detection never touches stock: the Stop Mold shelf row is unchanged, only the Keypad lines came off.
+    assert.strictEqual(off.inventory.find((row) => row[1] === SEAL[1])[3], '60.00');
+    assert.strictEqual(off.inventory.find((row) => row[1] === PARTS.KEYPAD[1])[3], '8.00');
+});
+
+test('only exactly "on" turns the push on: other values leave it off', async () => {
+    for (const value of ['', 'true', '1', 'ON', 'On', ' on', 'on ', 'yes', 'enabled', 'off']) {
+        const sheet = createSheet();
+        sheet.reset([SEAL]);
+        const t = countingTokens({ ...tokens });
+        const inv = withPushEnv(value, () => loadInventory({ sheet, tokens: t.tokens }));
+        await withConsole(async () => {
+            await inv.call('POST', CHECKOUT, { body: { techName: 'Brett Miller', items: [line("Stop Mold | 7' White", 2, '4001')] } });
+            await settle();
+        });
+        assert.strictEqual(inv.pushes.length, 0, JSON.stringify(value));
+        assert.deepStrictEqual(t.seen, [], JSON.stringify(value));
+    }
+});
