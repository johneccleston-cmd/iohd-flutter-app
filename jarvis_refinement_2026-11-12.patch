+test('a result too long to send keeps its totals whole, stays valid JSON and says what was left out', () => {
+    const rows = (n, label) => Array.from({ length: n }, (_, i) => ({ label: `${label} number ${i} with a long name to take up room`, jobs: i, revenue: i * 1000.5 }));
+    const big = { totals: { total_jobs: 123456, total_revenue: 9876543.21 }, groups: rows(4000, 'Customer'), other: rows(300, 'Other'), note: 'kept' };
+    const out = fitResult(big);
+    assert.ok(out.length <= 20000, `fits (${out.length})`);
+    const parsed = JSON.parse(out);
+    assert.deepEqual(parsed.totals, big.totals, 'totals are never touched');
+    assert.equal(parsed.note, 'kept');
+    assert.match(parsed.shortened, /groups: the first (\d+) of 4000 rows/);
+    assert.equal(parsed.groups.length, Number(/groups: the first (\d+) of 4000/.exec(parsed.shortened)[1]));
+    assert.deepEqual(parsed.groups[0], big.groups[0], 'rows are kept from the top');
+    // short results pass through untouched, and so does an empty one
+    assert.equal(fitResult({ totals: { jobs: 0 }, groups: [] }), '{"totals":{"jobs":0},"groups":[]}');
+    assert.equal(fitResult([]), '[]');
+    // one enormous text field cannot be shortened row by row: it is cut, and says so
+    assert.match(fitResult({ text: 'x'.repeat(50000) }), /truncated, narrow the query/);
+});
