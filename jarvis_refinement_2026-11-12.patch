+// The 2026-11-12 reliability pass: figures the model used to work out itself (sums, shares, margins, win rates, a balance's
+// move, one person's pay) now come from the lookups; filters it lacked (customer, open jobs, value, words in a job's text)
+// are there; every result says which dates it covered; and the prompt carries every common date range ready-made.
+// Against the made-up company in test/assistant_eval_fixture.js, "today" pinned to Tue 2026-10-27; the sums are in its comments.
+//
+// Opt-in: skipped unless TEST_DATABASE_URL points at a throwaway Postgres (NEVER production).
+
+require('./support');
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { withFixture, seedDoors, seedInsights, seedPayroll, NOW_JS } = require('./assistant_eval_fixture');
+const assistant = require('../src/assistant');
+const { stripProfit } = require('../src/assistantAccess');
+const { runTool, setClock, systemPrompt } = assistant._internals;
+
+const URL_ = process.env.TEST_DATABASE_URL;
+const skip = URL_ ? false : 'set TEST_DATABASE_URL to run these tests (a throwaway Postgres, never production)';
+
+async function call(db, name, input = {}, ctx = {}) {
+    const r = await runTool(db, name, input, ctx);
+    assert.ok(!r.is_error, `${name}: ${r.content}`);
